<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_process_bhsoft_mail_queue" model="ir.cron">
            <field name="name">BHSoft: Process Outgoing Mail Queue (30 messages per batch)</field>
            <field name="model_id" ref="model_bhsoft_mail_queue"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_mail_queue()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>

        <record id="ir_cron_sync_bhsoft_mail_queue" model="ir.cron">
            <field name="name">BHSoft: Synchronize Odoo Mail Status</field>
            <field name="model_id" ref="model_bhsoft_mail_queue"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_sync_status()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_sync_google_sheets" model="ir.cron">
            <field name="name">BHSoft: Import Google Sheets Sources</field>
            <field name="model_id" ref="model_bhsoft_google_sheet_source"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_google_sheets()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>

        <record id="ir_cron_sync_sendgrid_activity" model="ir.cron">
            <field name="name">BHSoft: Synchronize SendGrid Status via API</field>
            <field name="model_id" ref="model_bhsoft_mail_queue"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_sendgrid_activity()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
