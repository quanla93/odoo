<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bhsoft_mail_queue_tree" model="ir.ui.view">
        <field name="name">bhsoft.mail.queue.tree</field>
        <field name="model">bhsoft.mail.queue</field>
        <field name="arch" type="xml">
            <list decoration-info="status in ('processing', 'queued')" decoration-success="status in ('sent', 'delivered', 'opened', 'clicked')" decoration-danger="status in ('failed', 'unknown', 'bounced', 'dropped', 'spamreport', 'unsubscribed')" decoration-muted="status in ('duplicate', 'skipped', 'cancelled')">
                <header>
                    <button name="action_send_now" string="Send Now" type="object" class="btn-primary"/>
                    <button name="action_cancel_scheduled" string="Cancel Scheduled" type="object" class="btn-secondary"/>
                    <button name="action_sync_status" type="object" string="Sync Odoo Status"/>
                    <button name="action_sync_sendgrid_activity" type="object" string="Sync SendGrid API"/>
                </header>
                <field name="name"/>
                <field name="email_to"/>
                <field name="company_name" optional="show"/>
                <field name="subject"/>
                <field name="status" widget="badge"
                       decoration-info="status in ('processing', 'queued')"
                       decoration-success="status in ('sent', 'delivered', 'opened', 'clicked')"
                       decoration-danger="status in ('failed', 'unknown', 'bounced', 'dropped', 'spamreport', 'unsubscribed')"
                       decoration-muted="status in ('duplicate', 'skipped', 'cancelled')"/>
                <field name="source_row_number" optional="hide"/>
                <field name="import_batch_id" optional="hide"/>
                <field name="sheet_source_id" optional="show"/>
                <field name="sheet_row_id" optional="hide"/>
                <field name="source_conflict" optional="show"/>
                <field name="source_missing" optional="hide"/>
                <field name="last_sendgrid_event" optional="show"/>
                <field name="last_sendgrid_event_time" optional="show"/>
                <field name="scheduled_send_time"/>
                <field name="actual_sent_time"/>
                <button name="action_retry" type="object" string="Retry" icon="fa-refresh" invisible="status != 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_bhsoft_mail_queue_form" model="ir.ui.view">
        <field name="name">bhsoft.mail.queue.form</field>
        <field name="model">bhsoft.mail.queue</field>
        <field name="arch" type="xml">
            <form>
                <field name="status" invisible="1"/>
                <header>
                    <button name="action_send_now" string="Send Now" type="object" class="btn-primary" invisible="status != 'none'"/>
                    <button name="action_cancel_scheduled" string="Cancel Scheduled" type="object" class="btn-secondary" invisible="status not in ('none', 'queued')"/>
                    <button name="action_sync_status" type="object" string="Sync Odoo Status" class="btn-primary" invisible="status not in ('processing', 'queued', 'sent')"/>
                    <button name="action_sync_sendgrid_activity" type="object" string="Sync SendGrid API" class="btn-secondary" invisible="not sendgrid_msg_id"/>
                    <button name="action_retry" type="object" string="Retry Sending" class="btn-secondary" invisible="status != 'failed'"/>
                    <field name="status" widget="statusbar" statusbar_visible="none,processing,queued,sent,delivered,failed,unknown,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Recipient Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="email_to"/>
                            <field name="normalized_email" readonly="1"/>
                            <field name="company_name"/>
                            <field name="subject"/>
                        </group>
                        <group>
                            <field name="scheduled_send_time"/>
                            <field name="actual_sent_time"/>
                            <field name="mail_id"/>
                            <field name="sendgrid_msg_id"/>
                            <field name="sendgrid_batch_id"/>
                            <field name="suppression_id"/>
                        </group>
                    </group>
                    <group string="Cancellation" invisible="status != 'cancelled' and not cancel_error">
                        <group>
                            <field name="cancelled_at"/>
                            <field name="cancelled_by"/>
                        </group>
                        <group>
                            <field name="cancel_error"/>
                        </group>
                    </group>
                    <group string="SendGrid Status">
                        <group>
                            <field name="tracking_mode"/>
                            <field name="sendgrid_status"/>
                        </group>
                        <group>
                            <field name="last_sendgrid_event"/>
                            <field name="last_sendgrid_event_time"/>
                            <field name="last_sendgrid_sync_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Email Body">
                            <field name="body_html"/>
                        </page>
                        <page string="Source Data">
                            <group>
                                <group>
                                    <field name="source_row_uuid"/>
                                    <field name="source_row_number"/>
                                    <field name="import_batch_id"/>
                                    <field name="sheet_source_id"/>
                                    <field name="sheet_row_id"/>
                                    <field name="sheet_row_number"/>
                                    <field name="sync_run_id"/>
                                </group>
                                <group>
                                    <field name="duplicate_of_id"/>
                                    <field name="hubspot_id"/>
                                    <field name="linkedin_url"/>
                                    <field name="company_website"/>
                                    <field name="source_synced_at"/>
                                    <field name="source_missing"/>
                                    <field name="source_conflict"/>
                                    <field name="source_conflict_message"/>
                                </group>
                            </group>
                        </page>
                        <page string="Error Details" invisible="status not in ('failed', 'unknown', 'bounced', 'dropped', 'spamreport', 'unsubscribed', 'duplicate', 'skipped')">
                            <field name="error_message"/>
                        </page>
                        <page string="SendGrid Events">
                            <field name="event_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="event_time"/>
                                    <field name="event_type"/>
                                    <field name="source"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="API Sync History">
                            <field name="api_sync_log"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bhsoft_mail_queue_search" model="ir.ui.view">
        <field name="name">bhsoft.mail.queue.search</field>
        <field name="model">bhsoft.mail.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email_to"/>
                <field name="normalized_email"/>
                <field name="company_name"/>
                <field name="subject"/>
                <field name="import_batch_id"/>
                <field name="sheet_source_id"/>
                <field name="sheet_row_id"/>
                <filter string="Queue" name="queue" domain="[('status', 'in', ('none', 'processing', 'queued'))]"/>
                <filter string="Source Conflicts" name="source_conflicts" domain="[('source_conflict', '=', True)]"/>
                <filter string="Missing From Source" name="source_missing" domain="[('source_missing', '=', True)]"/>
                <filter string="Sent / Engaged" name="success" domain="[('status', 'in', ('sent', 'delivered', 'opened', 'clicked'))]"/>
                <filter string="Failed / Review" name="failed" domain="[('status', 'in', ('failed', 'unknown', 'bounced', 'dropped', 'spamreport', 'unsubscribed'))]"/>
                <filter string="Duplicate / Skipped" name="duplicate" domain="[('status', 'in', ('duplicate', 'skipped'))]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Group by Status" name="group_by_status" context="{'group_by':'status'}"/>
                <filter string="Group by Batch" name="group_by_import_batch" context="{'group_by':'import_batch_id'}"/>
                <filter string="Group by SendGrid Event" name="group_by_event" context="{'group_by':'last_sendgrid_event'}"/>
            </search>
        </field>
    </record>

    <record id="action_bhsoft_mail_queue_pending" model="ir.actions.act_window">
        <field name="name">Outgoing Queue</field>
        <field name="res_model">bhsoft.mail.queue</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', 'in', ('none', 'processing', 'queued'))]</field>
        <field name="search_view_id" ref="view_bhsoft_mail_queue_search"/>
    </record>

    <record id="action_bhsoft_mail_queue_history" model="ir.actions.act_window">
        <field name="name">Sending History</field>
        <field name="res_model">bhsoft.mail.queue</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', 'in', ('sent', 'delivered', 'opened', 'clicked', 'failed', 'unknown', 'bounced', 'dropped', 'spamreport', 'unsubscribed', 'cancelled'))]</field>
        <field name="search_view_id" ref="view_bhsoft_mail_queue_search"/>
    </record>

    <record id="action_bhsoft_mail_queue_duplicates" model="ir.actions.act_window">
        <field name="name">Duplicate / Skipped</field>
        <field name="res_model">bhsoft.mail.queue</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', 'in', ('duplicate', 'skipped'))]</field>
        <field name="search_view_id" ref="view_bhsoft_mail_queue_search"/>
    </record>

    <record id="action_bhsoft_mail_queue_all" model="ir.actions.act_window">
        <field name="name">All Messages</field>
        <field name="res_model">bhsoft.mail.queue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bhsoft_mail_queue_search"/>
    </record>

    <!-- Keep existing XML IDs upgrade-safe, but expose these commands only as list header buttons. -->
    <record id="action_mail_queue_send_now" model="ir.actions.server">
        <field name="name">Send Now</field>
        <field name="model_id" ref="model_bhsoft_mail_queue"/>
        <field name="binding_model_id" eval="False"/>
        <field name="state">code</field>
        <field name="code">action = records.action_send_now() if records else False</field>
    </record>

    <record id="action_mail_queue_cancel_scheduled" model="ir.actions.server">
        <field name="name">Cancel Scheduled</field>
        <field name="model_id" ref="model_bhsoft_mail_queue"/>
        <field name="binding_model_id" eval="False"/>
        <field name="state">code</field>
        <field name="code">action = records.action_cancel_scheduled() if records else False</field>
    </record>

</odoo>
