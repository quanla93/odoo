<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bhsoft_google_sheet_sync_run_list" model="ir.ui.view">
        <field name="name">bhsoft.google.sheet.sync.run.list</field>
        <field name="model">bhsoft.google.sheet.sync.run</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'success'" decoration-warning="state == 'partial'" decoration-danger="state == 'failed'">
                <field name="source_id"/>
                <field name="started_at"/>
                <field name="finished_at"/>
                <field name="state" widget="badge"/>
                <field name="total_count"/>
                <field name="created_count"/>
                <field name="updated_count"/>
                <field name="unchanged_count" optional="hide"/>
                <field name="duplicate_count"/>
                <field name="conflict_count"/>
                <field name="error_count"/>
            </list>
        </field>
    </record>

    <record id="view_bhsoft_google_sheet_sync_run_form" model="ir.ui.view">
        <field name="name">bhsoft.google.sheet.sync.run.form</field>
        <field name="model">bhsoft.google.sheet.sync.run</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="source_id"/>
                            <field name="state" widget="badge"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                        </group>
                        <group>
                            <field name="total_count"/>
                            <field name="created_count"/>
                            <field name="updated_count"/>
                            <field name="unchanged_count"/>
                            <field name="duplicate_count"/>
                            <field name="conflict_count"/>
                            <field name="error_count"/>
                        </group>
                    </group>
                    <group string="Run Error" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list decoration-danger="result == 'error'" decoration-warning="result in ('duplicate', 'conflict')">
                            <field name="row_number"/>
                            <field name="row_id"/>
                            <field name="email"/>
                            <field name="result" widget="badge"/>
                            <field name="message"/>
                            <field name="queue_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bhsoft_google_sheet_sync_line_list" model="ir.ui.view">
        <field name="name">bhsoft.google.sheet.sync.line.list</field>
        <field name="model">bhsoft.google.sheet.sync.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="result == 'error'" decoration-warning="result in ('duplicate', 'conflict')">
                <field name="source_id"/>
                <field name="run_id"/>
                <field name="row_number"/>
                <field name="row_id"/>
                <field name="email"/>
                <field name="result" widget="badge"/>
                <field name="message"/>
                <field name="queue_id"/>
            </list>
        </field>
    </record>

    <record id="view_bhsoft_google_sheet_sync_line_form" model="ir.ui.view">
        <field name="name">bhsoft.google.sheet.sync.line.form</field>
        <field name="model">bhsoft.google.sheet.sync.line</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="source_id"/>
                        <field name="run_id"/>
                        <field name="row_number"/>
                        <field name="row_id"/>
                        <field name="email"/>
                        <field name="result" widget="badge"/>
                        <field name="queue_id"/>
                    </group>
                    <field name="message" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bhsoft_google_sheet_sync_line_search" model="ir.ui.view">
        <field name="name">bhsoft.google.sheet.sync.line.search</field>
        <field name="model">bhsoft.google.sheet.sync.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="source_id"/>
                <field name="row_id"/>
                <field name="email"/>
                <filter string="Errors" name="errors" domain="[('result', '=', 'error')]"/>
                <filter string="Conflicts" name="conflicts" domain="[('result', '=', 'conflict')]"/>
                <filter string="Duplicates" name="duplicates" domain="[('result', '=', 'duplicate')]"/>
                <filter string="Group by Source" name="group_source" context="{'group_by': 'source_id'}"/>
                <filter string="Group by Result" name="group_result" context="{'group_by': 'result'}"/>
            </search>
        </field>
    </record>

    <record id="action_bhsoft_google_sheet_sync_runs" model="ir.actions.act_window">
        <field name="name">Google Sheets Sync Runs</field>
        <field name="res_model">bhsoft.google.sheet.sync.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bhsoft_google_sheet_sync_errors" model="ir.actions.act_window">
        <field name="name">Google Sheets Row Results</field>
        <field name="res_model">bhsoft.google.sheet.sync.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('result', 'in', ('error', 'conflict', 'duplicate'))]</field>
        <field name="search_view_id" ref="view_bhsoft_google_sheet_sync_line_search"/>
    </record>
</odoo>
